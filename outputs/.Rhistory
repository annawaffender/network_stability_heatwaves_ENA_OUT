lm_max_eigenvalue <- lm(max_eigenvalue ~ treat, data = df_re_max)
summary(lm_max_eigenvalue)
par(mfrow = c(2, 2))
plot(lm_max_eigenvalue)
results_list <- vector("list", length(interaction_tank_matrices))
for (m in seq_along(interaction_tank_matrices)) {
tank_name <- names(interaction_tank_matrices)[m]
X <- interaction_tank_matrices[[m]]
rownames(X) <- colnames(X)
diag(X) <- 0
g_X <- graph_from_adjacency_matrix(X, weighted = TRUE)
all_cycles_X <- simple_cycles(g_X)
## keep only cycles with length >= 3
cycle_lengths <- sapply(all_cycles_X$vertices, length)
valid_cycles <- which(cycle_lengths >= 3) # loop cylces: bigger/ same as three
#valid_cycles <- which(cycle_lengths == 3) # loop cycles: excately three
filtered_vertices <- all_cycles_X$vertices[valid_cycles]
filtered_edges    <- all_cycles_X$edges[valid_cycles]
## ---------------------------------------------------------
## REMOVE ALL CYCLES THAT CONTAIN POC
## ---------------------------------------------------------
keep <- !sapply(filtered_vertices, function(v) {
"POC" %in% v$name
})
filtered_vertices <- filtered_vertices[keep]
filtered_edges    <- filtered_edges[keep]
## skip if nothing remains
if (length(filtered_vertices) == 0) {
results_list[[m]] <- data.frame(
tank = tank_name,
num_heaviest_loop = NA,
weight_heaviest_loop = NA,
edges_heaviest_loop = NA_character_
)
next
}
## ---------------------------------------------------------
## compute loop weights
## ---------------------------------------------------------
loop_weight <- numeric(length(filtered_vertices))
for (k in seq_along(filtered_vertices)) {
v_input <- filtered_vertices[[k]]$name
v_path <- c(v_input, v_input[1])
edge_weights <- mapply(
function(i, j) abs(X[i, j]),
v_path[-length(v_path)],
v_path[-1]
)
loop_weight[k] <- prod(edge_weights)
}
## heaviest loop
max_idx <- which.max(loop_weight)
max_weight <- loop_weight[max_idx]
max_edges <- paste(
as_ids(filtered_edges[[max_idx]]),
collapse = " -> "
)
## save results
results_list[[m]] <- data.frame(
tank = tank_name,
num_heaviest_loop = valid_cycles[keep][max_idx],
weight_heaviest_loop = max_weight,
edges_heaviest_loop = max_edges
)
}
df_loop_weights <- do.call(rbind, results_list)
df_loop_weights
## merge data frames
df_combined <- merge(df_loop_weights, df_re_max, by = "tank")
## plot to test visual correlation
plot(df_combined$max_eigenvalue,
df_combined$weight_heaviest_loop)
## test correlation
cor.test(df_combined$max_eigenvalue,
df_combined$weight_heaviest_loop)
## Add HW treatments
df_loop_weights$treat <- c("0HW", "0HW", "3HW", "1HW", "1HW", "0HW", "0HW", "3HW", "3HW", "1HW", "1HW")
## HW colors
HW_col <- c("0HW" = "#1F5673","1HW" = "#E3B505","3HW" = "#D95D39")
HW_col_light <- c("0HW" = "#94BAD7","1HW" = "#FFE0A0","3HW" = "#FFBBB1")
## Summary statistics
df_loop_summary <- df_loop_weights %>%
group_by(treat) %>%
summarise(mean_weight = mean(weight_heaviest_loop, na.rm = TRUE),
sd_weight   = sd(weight_heaviest_loop, na.rm = TRUE),
.groups = "drop")
## Plot
plot_loop_weights <- ggplot() +
geom_point(data = df_loop_summary,
aes(x = treat, y = mean_weight, color = treat),
size = 5) +
geom_errorbar(data = df_loop_summary,
aes(x = treat, ymin = mean_weight - sd_weight, ymax = mean_weight + sd_weight, color = treat),
width = 0.2,linewidth = 1) +
geom_jitter(data = df_loop_weights,
aes(x = treat, y = weight_heaviest_loop, fill = treat),
shape = 21, color = "black", width = 0.15, size = 4.25, alpha = 1) +
scale_fill_manual(values = HW_col_light) +
scale_color_manual(values = HW_col) +
scale_x_discrete(labels = c("0HW" = "0", "1HW" = "1", "3HW" = "3")) +
labs(x = "\nHeatwaves",y = "Heaviest loop weight\n") +
theme_light(base_size = 24) +
theme(panel.grid = element_blank(),
legend.position = "none",
axis.title.x = element_text(size = 28),
axis.title.y = element_text(size = 28),
axis.text.x  = element_text(size = 25),
axis.text.y  = element_text(size = 25))
plot_loop_weights
df_loop_weights$treat <- factor(df_loop_weights$treat)
lm_loop_weights <- lm(weight_heaviest_loop ~ treat, data = df_loop_weights)
summary(lm_loop_weights)
par(mfrow = c(2, 2))
plot(lm_loop_weights)
## merge data frames
df_combined <- merge(df_loop_weights, df_re_max, by = "tank")
## plot to test visual correlation
plot(df_combined$max_eigenvalue,
df_combined$weight_heaviest_loop)
## test correlation
cor.test(df_combined$max_eigenvalue,
df_combined$weight_heaviest_loop)
rm(list=ls(all=TRUE))
#install.packages("igraph")
library(readxl)
library(igraph)
library(dplyr)
library(ggplot2)
###################################
##						##
### Load data & set parameters  ###
##						##
###################################
your_path <- "/Users/anna/Anna/Karriere/PhD/Scotti Lab/1_WP" # replace with your path to Github folder
output_path <- file.path(your_path,"/Github/network_stability_heatwaves_m/outputs")
data_path <- file.path(your_path,"/Github/network_stability_heatwaves_m/dataframes")
setwd(output_path)
interaction_tank_matrices <- readRDS(file.path(output_path,"list_interactions_matrices.rds"))
edgelist_path <- paste0(data_path, "/", "1_source_data.xlsx")
df_edgelist <- as.data.frame(read_xlsx(edgelist_path, sheet = "edgelist"))
edges <- df_edgelist[c("resource", "consumer")]
## delete FA interactions in tank B2
## due to very low FA biomass, this interaction is very high and screws error bars when plotting
if ("B2" %in% names(interaction_tank_matrices)) {
B2 <- interaction_tank_matrices[["B2"]]
B2["FA", B2["FA", ] != 0] <- 0
interaction_tank_matrices[["B2"]] <- B2
}
##############################
##
##      EIGENVALUES      ##
##
##
##############################
interaction_tank_matrices_2 <- interaction_tank_matrices
## Set diagonal to zero to exclude mortalities
interactions_zero_mort <- lapply(interaction_tank_matrices_2, function(X) {
diag(X) <- 0
X
})
## Calculate the Eigenvektors of each matrix
## How much self-regulation would need to be added to stabilize the system?
## The closer Re(λmax) to zero, the closer the system is to stability
eigenvalues_list <- lapply(interactions_zero_mort, function(mat) eigen(mat)$values) # neg. real parts of eigenvalues indicate stability
eigenvalues_list
## Extract max. Eigenvalue for each tank
re_max_abs <- unlist(lapply(eigenvalues_list,function(x)max(abs(Re(x))))) # extract max. Eigenvalue for each tank
re_max <- sapply(eigenvalues_list, function(x) {max(Re(x))})
df_re_max <- data.frame(tank = names(re_max_abs), max_eigenvalue = as.numeric(re_max_abs))
df_re_max$treat <- c("0HW", "0HW", "3HW", "1HW", "1HW", "0HW", "0HW", "3HW", "3HW", "1HW", "1HW")
## Extract absolute max. Eigenvalue for each tank
df_re_max_abs <- data.frame(tank = names(re_max_abs), max_eigenvalue = as.numeric(re_max_abs))
df_re_max_abs$treat <- c("0HW", "0HW", "3HW", "1HW", "1HW", "0HW", "0HW", "3HW", "3HW", "1HW", "1HW")
HW_col = c("#1F5673", "#E3B505", "#D95D39")
ggplot(df_re_max, aes(x = treat, y = max_eigenvalue, fill = treat)) +
geom_boxplot(outlier.shape = NA) +
geom_point(position = position_jitter(width = 0.1), size = 2) +
labs(x = "Treatment", y = "Max eigenvalue") +
scale_fill_manual(values = HW_col) +
theme_light(base_size = 24) +
theme(panel.grid = element_blank(),
legend.position = "none",
axis.title.x = element_text(size = 28),
axis.title.y = element_text(size = 28),
axis.text.x  = element_text(size = 25),
axis.text.y  = element_text(size = 25))
## STATS
#df_loop_weights$treat <- factor(df_loop_weights$treat)
lm_max_eigenvalue <- lm(max_eigenvalue ~ treat, data = df_re_max)
summary(lm_max_eigenvalue)
par(mfrow = c(2, 2))
plot(lm_max_eigenvalue)
################################################### INDIVIDUAL TANKS ##################################################
# ## Select individual tank
# interact_tank <- interaction_tank_matrices[c("A2")] # change tank selection
# tank <- interact_tank$A2 # change tank selection
#
# ## Set diagonal to zero to exclude mortalities
# diag(tank) <- rep(0,nrow(tank))
#
#
# ###################################
# ##						##
# ###   Extract all loop cycles   ###
# ##						##
# ###################################
#
# ## Build graph from non-zero interactions
# g <- graph_from_adjacency_matrix(tank != 0,mode = "directed",diag = FALSE)
# g
#
# ## Find simple directed cycles
# cycles <- simple_cycles(g)
# cycles
#
#
# ###################################
# ##						##
# ###          PLOT               ###
# ##						##
# ###################################
#
# edges_df <- graph_from_data_frame(edges, directed = TRUE)
# edges_df
#
# edges_cycles <- simple_cycles(edges_df)
# edges_cycles
#
#
# lay <- layout_with_fr(edges_df) # base layout (you can swap kk/fr if you prefer)
# vnames <- V(edges_df)$name # get vertex names
# bottom_nodes <- c("ZM", "FV", "FA", "POC") # nodes that should be at bottom
# lay[vnames %in% bottom_nodes, 2] <- min(lay[,2]) - 2 # push them down (more negative = lower)
#
# plot(edges_df,layout = lay,edge.arrow.size = 0.2)
#
#
#
################################################### LOOP TANKS ##################################################
##############################################
###
##    loop weight for all tanks     ##
###
##############################################
results_list <- vector("list", length(interaction_tank_matrices)) # loop through all tanks
## loop over all matrices
for (m in seq_along(interaction_tank_matrices)) {
tank_name <- names(interaction_tank_matrices)[m]
X <- interaction_tank_matrices[[m]]   # Choose tank interaction matrix
rownames(X) <- colnames(X)   # make rownames match colnames
diag(X) <- 0   # remove self-links
g_X <- graph_from_adjacency_matrix(X, weighted = TRUE) # create graph
all_cycles_X <- simple_cycles(g_X) # get all simple cycles
####### Adjust loop length filter #######
## keep only cycles with length >= X
cycle_lengths <- sapply(all_cycles_X$vertices, length)
valid_cycles <- which(cycle_lengths >= 3)
## skip tanks with no valid cycles
if (length(valid_cycles) == 0) {
results_list[[m]] <- data.frame(tank = tank_name,
num_heaviest_loop = NA,
weight_heaviest_loop = NA,
edges_heaviest_loop = NA_character_)
next
}
## subset cycles
filtered_vertices <- all_cycles_X$vertices[valid_cycles]
filtered_edges <- all_cycles_X$edges[valid_cycles]
## vector for loop weights
loop_weight <- numeric(length(filtered_vertices))
## calculate loop weights
for (k in seq_along(filtered_vertices)) {
v_input <- filtered_vertices[[k]]$name
l_cycle <- length(v_input)
s_edges <- numeric(l_cycle)
v_names <- c(v_input, v_input[1])  # close loop
for (i in seq_len(l_cycle)) {
s_edges[i] <- abs(X[v_names[i], v_names[i + 1]])}
## product of edge weights
loop_weight[k] <- prod(s_edges)
}
## heaviest loop
max_idx <- which.max(loop_weight)
max_weight <- loop_weight[max_idx]
## readable edge sequence
max_edges <- paste(as_ids(filtered_edges[[max_idx]]), collapse = " -> ")
## save results
results_list[[m]] <- data.frame(tank = tank_name,
num_heaviest_loop = valid_cycles[max_idx],
weight_heaviest_loop = max_weight,
edges_heaviest_loop = max_edges)
}
## combine results
df_loop_weights <- do.call(rbind, results_list)
df_loop_weights
##############################################
###
##   MLW + max. Eigenvalues for all tanks     ##
###
##############################################
## merge data frames
df_combined <- merge(df_loop_weights, df_re_max, by = "tank")
## plot to test visual correlation
plot(df_combined$weight_heaviest_loop,
df_combined$max_eigenvalue,
pch = 19,
xlab = "Maximum loop weight", #
ylab = "Re(λmax)") # dominant eigenvalue
abline(lm(max_eigenvalue ~ weight_heaviest_loop, data = df_combined),col = "red",lwd = 2)
## test correlation
cor.test(df_combined$max_eigenvalue,
df_combined$weight_heaviest_loop)
cor.test(df_combined$weight_heaviest_loop,df_combined$max_eigenvalue,
# method = "pearson") # assumes normal distribution
method = "spearman") # normal distribution not necesaary; more robust against outliers
#############################################
##						      ##
##              BAR PLOT                  ##
##						      ##
#############################################
## Add HW treatments
df_loop_weights$treat <- c("0HW", "0HW", "3HW", "1HW", "1HW", "0HW", "0HW", "3HW", "3HW", "1HW", "1HW")
## HW colors
HW_col <- c("0HW" = "#1F5673","1HW" = "#E3B505","3HW" = "#D95D39")
HW_col_light <- c("0HW" = "#94BAD7","1HW" = "#FFE0A0","3HW" = "#FFBBB1")
## Summary statistics
df_loop_summary <- df_loop_weights %>%
group_by(treat) %>%
summarise(mean_weight = mean(weight_heaviest_loop, na.rm = TRUE),
sd_weight   = sd(weight_heaviest_loop, na.rm = TRUE),
.groups = "drop")
## Plot
plot_loop_weights <- ggplot() +
geom_point(data = df_loop_summary,
aes(x = treat, y = mean_weight, color = treat),
size = 5) +
geom_errorbar(data = df_loop_summary,
aes(x = treat, ymin = mean_weight - sd_weight, ymax = mean_weight + sd_weight, color = treat),
width = 0.2,linewidth = 1) +
geom_jitter(data = df_loop_weights,
aes(x = treat, y = weight_heaviest_loop, fill = treat),
shape = 21, color = "black", width = 0.15, size = 4.25, alpha = 1) +
scale_fill_manual(values = HW_col_light) +
scale_color_manual(values = HW_col) +
scale_x_discrete(labels = c("0HW" = "0", "1HW" = "1", "3HW" = "3")) +
labs(x = "\nHeatwaves",y = "Heaviest loop weight\n") +
theme_light(base_size = 24) +
theme(panel.grid = element_blank(),
legend.position = "none",
axis.title.x = element_text(size = 28),
axis.title.y = element_text(size = 28),
axis.text.x  = element_text(size = 25),
axis.text.y  = element_text(size = 25))
plot_loop_weights
###################################
##						##
##          STATS                ##
##						##
###################################
df_loop_weights$treat <- factor(df_loop_weights$treat)
lm_loop_weights <- lm(weight_heaviest_loop ~ treat, data = df_loop_weights)
summary(lm_loop_weights)
par(mfrow = c(2, 2))
plot(lm_loop_weights)
############################################ DELETE ALL POC #########################################
valid_cycles <- which(!sapply(all_cycles_X$vertices, function(v) {"POC" %in% v$name}))
filtered_vertices <- all_cycles_X$vertices[valid_cycles]
filtered_edges    <- all_cycles_X$edges[valid_cycles]
#sapply(filtered_vertices, function(v) "POC" %in% v$name)
all_cycles_X_no_POC <- list(vertices = all_cycles_X$vertices[!sapply(all_cycles_X$vertices, function(v) "POC" %in% v$name)],
edges = all_cycles_X$edges[!sapply(all_cycles_X$vertices, function(v) "POC" %in% v$name)])
## plot to test visual correlation
plot(df_combined$weight_heaviest_loop,
df_combined$max_eigenvalue,
pch = 19,
xlab = "Maximum loop weight", #
ylab = "Re(λmax)") # dominant eigenvalue
abline(lm(max_eigenvalue ~ weight_heaviest_loop, data = df_combined),col = "red",lwd = 2)
## test correlation
cor.test(df_combined$max_eigenvalue,
df_combined$weight_heaviest_loop)
cor.test(df_combined$weight_heaviest_loop,df_combined$max_eigenvalue,
# method = "pearson") # assumes normal distribution
method = "spearman") # normal distribution not necesaary; more robust against outliers
rm(list=ls(all=TRUE))
